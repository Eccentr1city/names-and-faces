# Copy this file to .env and fill in what you need. Every variable is optional.
# .env is gitignored; run.py loads it at startup, so restart the service after edits.

# Port for the Flask server (and the Tailscale serve entry). Default 5050.
#NAMES_AND_FACES_PORT=5050

# Where the SQLite database and photos live. Default ~/.names-and-faces.
# An iCloud path gives you automatic backup:
#NAMES_AND_FACES_DATA_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/names-and-faces-data"

# LinkedIn li_at session cookie: unlocks profiles behind LinkedIn's login wall.
# Chrome DevTools > Application > Cookies > linkedin.com > li_at, or on macOS:
#   eval $(bash scripts/get-linkedin-cookie.sh)
LINKEDIN_LI_AT=

# Anthropic API key: summarises scraped bios into one-line context and extracts
# profile info from arbitrary personal sites.
ANTHROPIC_API_KEY=

# AnkiConnect endpoint, if you moved the add-on off its default port 8765.
#ANKICONNECT_URL=http://127.0.0.1:8766

# Required if the AnkiConnect add-on has an apiKey set (e.g. when reached over Tailscale).
#ANKICONNECT_API_KEY=

# Bind address and Flask debug mode (debug reloader on by default for local use).
#NAMES_AND_FACES_HOST=127.0.0.1
#NAMES_AND_FACES_DEBUG=1
